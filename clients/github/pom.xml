<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-forge-clients-clients</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-forge-client-github</artifactId>
    <name>Porelo GitHub Client</name>
    <description>GitHub review and Actions API client</description>
    <properties>
        <skipPublishing>false</skipPublishing>
        <openapi.extract>github.json</openapi.extract>
        <openapi.package>org.fuin.porelo.forge.github.model</openapi.package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The tests jar for other repositories' tests: the replaying client and the recordings, nothing else. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>tests-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>org/fuin/porelo/forge/github/replay/**</include>
                                <include>org/fuin/porelo/forge/github/recordings/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-extract</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <executable>${java.home}/bin/java</executable>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-forge-client-openapi-extract</artifactId>
                            </executableDependency>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>org.fuin.porelo.forge.openapi.OpenApiExtract</argument>
                                <argument>check</argument>
                                <argument>--extract</argument>
                                <argument>${project.basedir}/src/main/openapi/github.json</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/jobs/{job_id}/logs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/runs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/runs/{run_id}/jobs</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/check-runs</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/check-runs/{check_run_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/collaborators/{username}/permission</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/commits/{ref}/check-runs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/compare/{basehead}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/git/ref/{ref}</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/issues/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/issues/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/issues/{issue_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/pulls/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/pulls/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls/{pull_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument
                            >post /repos/{owner}/{repo}/pulls/{pull_number}/comments/{comment_id}/replies</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/reviews</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls/{pull_number}/reviews</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/reviews/{review_id}/comments</argument>
                                <argument>--operation</argument>
                                <argument>get /user</argument>
                                <argument>--operation</argument>
                                <argument>get /user/memberships/orgs/{org}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>record-github</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubRecorder</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/src/test/resources/org/fuin/porelo/forge/github/recordings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.fuin.porelo</groupId>
                        <artifactId>porelo-forge-client-openapi-extract</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>github-live</id>
            <activation>
                <property>
                    <name>github.live</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>live-github</id>
                                <phase>integration-test</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>org.fuin.porelo.forge.github.GitHubLiveCheck</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
