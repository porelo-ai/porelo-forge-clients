<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.fuin.porelo</groupId>
        <artifactId>porelo-forge-clients-clients</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>porelo-forge-client-github</artifactId>
    <name>Porelo GitHub Client</name>
    <description>GitHub review and Actions API client</description>
    <properties>
        <skipPublishing>false</skipPublishing>
        <openapi.extract>github.json</openapi.extract>
        <openapi.package>org.fuin.porelo.forge.github.model</openapi.package>
    </properties>
    <dependencies>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- The tests jar for other repositories' tests: the replaying client and the recordings, nothing else. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>tests-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>org/fuin/porelo/forge/github/replay/**</include>
                                <include>org/fuin/porelo/forge/github/recordings/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>check-extract</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>false</skip>
                            <executable>${java.home}/bin/java</executable>
                            <executableDependency>
                                <groupId>org.fuin.porelo</groupId>
                                <artifactId>porelo-forge-client-openapi-extract</artifactId>
                            </executableDependency>
                            <includeProjectDependencies>false</includeProjectDependencies>
                            <includePluginDependencies>true</includePluginDependencies>
                            <arguments>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>org.fuin.porelo.forge.openapi.OpenApiExtract</argument>
                                <argument>check</argument>
                                <argument>--extract</argument>
                                <argument>${project.basedir}/src/main/openapi/github.json</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/jobs/{job_id}/logs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/runs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/actions/runs/{run_id}/jobs</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/check-runs</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/check-runs/{check_run_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/collaborators/{username}/permission</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/commits/{ref}/check-runs</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/compare/{basehead}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/git/ref/{ref}</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/issues/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/issues/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/issues/{issue_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/pulls/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/pulls/comments/{comment_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls/{pull_number}/comments</argument>
                                <argument>--operation</argument>
                                <argument
                            >post /repos/{owner}/{repo}/pulls/{pull_number}/comments/{comment_id}/replies</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/commits</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/reviews</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/pulls/{pull_number}/reviews</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/pulls/{pull_number}/reviews/{review_id}/comments</argument>
                                <argument>--operation</argument>
                                <argument>get /user</argument>
                                <argument>--operation</argument>
                                <argument>get /user/memberships/orgs/{org}</argument>
                                <argument>--operation</argument>
                                <argument>delete /user/keys/{key_id}</argument>
                                <argument>--operation</argument>
                                <argument>delete /user/ssh_signing_keys/{ssh_signing_key_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /orgs/{org}/memberships/{username}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/commits/{ref}/status</argument>
                                <argument>--operation</argument>
                                <argument>get /user/keys</argument>
                                <argument>--operation</argument>
                                <argument>get /user/ssh_signing_keys</argument>
                                <argument>--operation</argument>
                                <argument>get /users/{username}/keys</argument>
                                <argument>--operation</argument>
                                <argument>get /users/{username}/ssh_signing_keys</argument>
                                <argument>--operation</argument>
                                <argument>post /orgs/{org}/repos</argument>
                                <argument>--operation</argument>
                                <argument>post /user/keys</argument>
                                <argument>--operation</argument>
                                <argument>post /user/ssh_signing_keys</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/issues</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/issues/{issue_number}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/parent</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/sub_issues</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/issues/{issue_number}/sub_issues</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/issues/{issue_number}/sub_issue</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/issues/{issue_number}/sub_issues/priority</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/dependencies/blocked_by</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/issues/{issue_number}/dependencies/blocked_by</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/issues/{issue_number}/dependencies/blocked_by/{issue_id}</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/issues/{issue_number}/dependencies/blocking</argument>
                                <argument>--operation</argument>
                                <argument>get /orgs/{org}/projectsV2/{project_number}/items</argument>
                                <argument>--operation</argument>
                                <argument>get /repos/{owner}/{repo}/labels</argument>
                                <argument>--operation</argument>
                                <argument>post /repos/{owner}/{repo}/labels</argument>
                                <argument>--operation</argument>
                                <argument>delete /repos/{owner}/{repo}/labels/{name}</argument>
                                <argument>--operation</argument>
                                <argument>patch /repos/{owner}/{repo}/labels/{name}</argument>
                                <argument>--operation</argument>
                                <argument>get /orgs/{org}/issue-fields</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>kept-github</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubKeptFixture</mainClass>
                            <classpathScope>test</classpathScope>
                        </configuration>
                    </execution>
                    <execution>
                        <id>kept-github-issues</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubIssueLiveCheck</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>keep</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>live-github-issues</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubIssueLiveCheck</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>check</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>record-github-issues</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubIssueRecorder</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/src/test/resources/org/fuin/porelo/forge/github/recordings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>record-github</id>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>org.fuin.porelo.forge.github.GitHubRecorder</mainClass>
                            <classpathScope>test</classpathScope>
                            <arguments>
                                <argument>${project.basedir}/src/test/resources/org/fuin/porelo/forge/github/recordings</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>org.fuin.porelo</groupId>
                        <artifactId>porelo-forge-client-openapi-extract</artifactId>
                        <version>${project.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- The native image's metadata, shipped in the jar so a native user needs no hints for the client's types.
             '-Pnative' builds the tests named by -Dtest into an image with no metadata but the module's own and runs
             them; with '-Dagent=true -DskipNativeTests' the JVM run records under GraalVM's tracing agent instead, and
             'prepare-package' then writes what was recorded as the shipped file (native-record below). -->
        <profile>
            <id>native</id>
            <dependencies>
                <dependency>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-launcher</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>test-native</id>
                                <phase>test</phase>
                                <goals>
                                    <goal>test</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- Only the module's own metadata: a library's from GraalVM's repository would hide a gap. -->
                            <metadataRepository>
                                <enabled>false</enabled>
                            </metadataRepository>
                            <buildArgs>
                                <buildArg>-march=x86-64</buildArg>
                            </buildArgs>
                            <agent>
                                <defaultMode>Standard</defaultMode>
                                <options>
                                    <builtinCallerFilter>true</builtinCallerFilter>
                                    <builtinHeuristicFilter>true</builtinHeuristicFilter>
                                    <callerFilterFiles>
                                        <filterFile>${project.basedir}/src/test/native-image/caller-filter.json</filterFile>
                                    </callerFilterFiles>
                                    <accessFilterFiles>
                                        <filterFile>${project.basedir}/src/test/native-image/access-filter.json</filterFile>
                                    </accessFilterFiles>
                                </options>
                            </agent>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>native-record</id>
            <activation>
                <property>
                    <name>agent</name>
                    <value>true</value>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>native-metadata</id>
                                <phase>prepare-package</phase>
                                <goals>
                                    <goal>java</goal>
                                </goals>
                                <configuration>
                                    <mainClass>org.fuin.porelo.forge.github.GitHubNativeMetadata</mainClass>
                                    <classpathScope>test</classpathScope>
                                    <arguments>
                                        <argument>${project.build.directory}/native/agent-output/test/reachability-metadata.json</argument>
                                        <argument>${project.build.directory}/github-model-samples.json</argument>
                                        <argument>${project.basedir}/src/main/resources/META-INF/native-image/org.fuin.porelo/porelo-forge-client-github/reachability-metadata.json</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>github-live</id>
            <activation>
                <property>
                    <name>github.live</name>
                </property>
            </activation>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>live-github</id>
                                <phase>integration-test</phase>
                                <goals><goal>java</goal></goals>
                                <configuration>
                                    <mainClass>org.fuin.porelo.forge.github.GitHubLiveCheck</mainClass>
                                    <classpathScope>test</classpathScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
