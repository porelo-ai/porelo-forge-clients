{
  "openapi": "3.1.0",
  "info": {
    "title": "Records fixture",
    "version": "1"
  },
  "paths": {
    "/reactions": {
      "get": {
        "operationId": "reaction",
        "responses": {
          "200": {
            "description": "A reaction",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/reaction"
                }
              }
            }
          }
        }
      }
    },
    "/permissions": {
      "get": {
        "operationId": "permissions",
        "responses": {
          "200": {
            "description": "Permissions with undeclared ones",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/permissions"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "reaction": {
        "type": "object",
        "required": ["id", "closed_at", "status", "verdict"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "closed_at": {
            "type": ["string", "null"]
          },
          "title": {
            "type": "string"
          },
          "+1": {
            "type": "integer"
          },
          "-1": {
            "type": "integer"
          },
          "state": {
            "type": "string",
            "enum": ["open", "closed"]
          },
          "conclusion": {
            "type": ["string", "null"],
            "enum": ["success", "failure", null]
          },
          "status": {
            "type": "string",
            "enum": ["queued", "completed"]
          },
          "verdict": {
            "type": ["string", "null"],
            "enum": ["approved", "rejected", null]
          }
        }
      },
      "permissions": {
        "type": "object",
        "properties": {
          "checks": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "string"
        }
      }
    }
  }
}
